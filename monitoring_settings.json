{
  "_meta": {
    "version": "1.7.0",
    "last_updated": "2026-11-14",
    "description": "Default test environment: one or more monitors per category for things every Windows 10/11 PC has, plus demo toggles (Notepad, the settings editor, the budget CSV, the monitor log size). See docs/test-environment.md.",
    "update_notes": "Bump version and update last_updated whenever you change this file."
  },
  "global": {
    "check_interval_sec": 6,
    "log_file": "logs\\monitor.log",
    "log_max_size_mb": 50,
    "email_recipient": "alerts@example.com",
    "email_sender": "monitor@example.com",
    "email_cooldown_min": 60,
    "scripts_dir": "scripts"
  },
  "processes": [
    {
      "name": "explorer.exe",
      "display_name": "Windows Explorer",
      "required": true,
      "check_interval_sec": 30,
      "actions": {
        "on_not_running": [
          {
            "type": "log_to_file",
            "level": "warning",
            "instructions": "Windows Explorer (the desktop shell) is not running.\n\n1. Press Ctrl+Shift+Esc to open Task Manager.\n2. File > Run new task > type explorer.exe > OK.\n3. If it keeps crashing, check Event Viewer > Windows Logs > Application."
          }
        ]
      }
    },
    {
      "name": "dwm.exe",
      "display_name": "Desktop Window Manager",
      "required": true,
      "check_interval_sec": 30,
      "actions": {
        "on_not_running": [
          {
            "type": "log_to_file",
            "level": "warning",
            "instructions": "The Desktop Window Manager (dwm.exe) draws every window on screen and normally restarts on its own within seconds.\n\n1. Wait a moment: Windows restarts it automatically.\n2. If the screen stays black or frozen, press Win+Ctrl+Shift+B to reset the graphics driver.\n3. If it keeps stopping, check Event Viewer > Windows Logs > Application for Desktop Window Manager errors."
          }
        ]
      }
    },
    {
      "name": "notepad.exe",
      "display_name": "Notepad (demo)",
      "required": true,
      "check_interval_sec": 30,
      "actions": {
        "on_not_running": [
          {
            "type": "log_to_file",
            "level": "warning",
            "instructions": "Demo process: Notepad is watched so you can see an alert and a recovery on demand.\n\n1. Open Notepad from the Start menu: the row turns green within 30 s.\n2. Close it: the row turns red, an alert is logged, and this runbook is shown.\n3. In a real setup, list the applications your machine must keep running here."
          }
        ]
      }
    }
  ],
  "performance": {
    "cpu": {
      "check_interval_sec": 5,
      "thresholds": [
        {
          "level": "warning",
          "percent": 80,
          "sustain_sec": 30,
          "description": "CPU above 80% sustained for 30s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING CPU: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            }
          ]
        },
        {
          "level": "critical",
          "percent": 95,
          "sustain_sec": 60,
          "description": "CPU above 95% sustained for 60s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL CPU: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] CPU Alert on {hostname} — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nMetric: CPU Usage\nCurrent Value: {current_value}%\nThreshold: {percent}%\nSustained for: {sustain_sec}s\n\nPlease investigate immediately."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_cpu_critical.ps1",
              "args": [
                "--level",
                "critical",
                "--value",
                "{current_value}"
              ]
            }
          ]
        }
      ]
    },
    "memory": {
      "check_interval_sec": 5,
      "thresholds": [
        {
          "level": "warning",
          "percent": 85,
          "sustain_sec": 30,
          "description": "RAM above 85% sustained for 30s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING MEM: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            }
          ]
        },
        {
          "level": "critical",
          "percent": 95,
          "sustain_sec": 30,
          "description": "RAM above 95% sustained for 30s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL MEM: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] Memory Alert on {hostname} — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nMetric: Memory Usage\nCurrent Value: {current_value}%\nThreshold: {percent}%\nSustained for: {sustain_sec}s\n\nPlease investigate immediately."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_memory_critical.ps1",
              "args": [
                "--level",
                "critical",
                "--value",
                "{current_value}"
              ]
            }
          ]
        }
      ]
    }
  },
  "disk": [
    {
      "drive": "C:\\",
      "display_name": "System Drive (C:)",
      "check_interval_sec": 60,
      "thresholds": [
        {
          "level": "warning",
          "percent_used": 75,
          "description": "Disk C: at 75% capacity",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING DISK C: {current_value}% used, {free_gb} GB free (threshold: {percent_used}%)"
            }
          ]
        },
        {
          "level": "critical",
          "percent_used": 90,
          "description": "Disk C: at 90% capacity",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL DISK C: {current_value}% used, {free_gb} GB free (threshold: {percent_used}%)"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] Disk Space Alert on {hostname} (C:) — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nDrive: C:\\\nUsed: {current_value}%\nFree Space: {free_gb} GB\nThreshold: {percent_used}%\n\nImmediate cleanup or expansion required."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_disk_critical.ps1",
              "args": [
                "--drive",
                "C:",
                "--value",
                "{current_value}"
              ]
            }
          ]
        }
      ]
    }
  ],
  "network": [
    {
      "name": "Internet (Cloudflare DNS)",
      "host": "1.1.1.1",
      "port": 53,
      "protocol": "icmp",
      "timeout_sec": 5,
      "check_interval_sec": 30,
      "thresholds": [
        {
          "level": "warning",
          "latency_ms": 150,
          "description": "Round-trip latency above 150 ms",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING NET: {host} latency {current_value}ms (threshold: {latency_ms}ms)"
            }
          ]
        },
        {
          "level": "critical",
          "condition": "unreachable",
          "description": "No ping reply: the internet connection may be down",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL NET: {host} unreachable"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] Network Outage on {hostname} — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nTarget: {host}:{port}\nStatus: UNREACHABLE\n\nPossible internet outage or gateway failure. Please investigate immediately."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_network_down.ps1",
              "args": [
                "--host",
                "{host}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Google DNS (TCP 53)",
      "host": "8.8.8.8",
      "port": 53,
      "protocol": "tcp",
      "timeout_sec": 5,
      "check_interval_sec": 60,
      "thresholds": [
        {
          "level": "warning",
          "latency_ms": 300,
          "description": "TCP connect slower than 300 ms",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING NET: {host}:{port} connect {current_value}ms (threshold: {latency_ms}ms)"
            }
          ]
        },
        {
          "level": "critical",
          "condition": "unreachable",
          "description": "TCP port 53 not reachable (internet down, or DNS blocked by a firewall)",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL NET: {host}:{port} unreachable"
            }
          ]
        }
      ]
    },
    {
      "name": "Monitoring Console",
      "host": "localhost",
      "port": 5758,
      "protocol": "tcp",
      "timeout_sec": 3,
      "check_interval_sec": 15,
      "thresholds": [
        {
          "level": "critical",
          "condition": "unreachable",
          "description": "Monitoring console on port 5758 not responding",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL SVC: localhost:5758 unreachable"
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_service_down.ps1",
              "args": [
                "--port",
                "5758"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Settings Editor (demo)",
      "host": "localhost",
      "port": 5757,
      "protocol": "tcp",
      "timeout_sec": 3,
      "check_interval_sec": 30,
      "thresholds": [
        {
          "level": "warning",
          "condition": "unreachable",
          "description": "Demo: the settings editor is closed. Open it with start_editor.bat (or the console's banner) and this turns green.",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING SVC: settings editor on localhost:5757 is not running (demo)"
            }
          ]
        }
      ]
    }
  ],
  "document": [
    {
      "display_name": "Groceries spend (monthly budget)",
      "measure": "sum",
      "path": "sample_data\\monthly_budget_sample.csv",
      "filter_column": "Category",
      "filter_value": "Groceries",
      "value_column": "Amount",
      "target": 400,
      "unit": "$",
      "check_interval_sec": 30,
      "thresholds": [
        {
          "level": "warning",
          "condition": "above",
          "percent_of_target": 80,
          "description": "Groceries spend above 80% of the monthly budget",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING DOC: {document} at {unit}{current_value} ({current_percent}% of {unit}{target}; threshold {percent_of_target}%)"
            }
          ]
        },
        {
          "level": "critical",
          "condition": "above",
          "percent_of_target": 100,
          "description": "Groceries budget used up",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL DOC: {document} at {unit}{current_value} ({current_percent}% of {unit}{target}; threshold {percent_of_target}%)"
            },
            {
              "type": "popup",
              "title": "Budget alert: {document}",
              "message_template": "{document} is at {unit}{current_value}, {current_percent}% of the {unit}{target} budget."
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] {document} over budget on {hostname} — {timestamp}",
              "body_template": "Document: {document}\nTimestamp: {timestamp}\nCurrent total: {unit}{current_value}\nTarget: {unit}{target}\nUsed: {current_percent}%\nThreshold: {percent_of_target}%\n\nReview the spending in the source file."
            }
          ]
        }
      ]
    },
    {
      "display_name": "Eating out spend (monthly budget)",
      "measure": "sum",
      "path": "sample_data\\monthly_budget_sample.csv",
      "filter_column": "Category",
      "filter_value": "Eating out",
      "value_column": "Amount",
      "target": 60,
      "unit": "$",
      "check_interval_sec": 30,
      "thresholds": [
        {
          "level": "warning",
          "condition": "above",
          "percent_of_target": 80,
          "description": "Eating out above 80% of its monthly budget",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING DOC: {document} at {unit}{current_value} ({current_percent}% of {unit}{target}; threshold {percent_of_target}%)"
            }
          ]
        },
        {
          "level": "critical",
          "condition": "above",
          "percent_of_target": 100,
          "description": "Eating out budget used up",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL DOC: {document} at {unit}{current_value} ({current_percent}% of {unit}{target}; threshold {percent_of_target}%)"
            },
            {
              "type": "popup",
              "title": "Budget alert: {document}",
              "message_template": "{document} is at {unit}{current_value}, {current_percent}% of the {unit}{target} budget."
            }
          ]
        }
      ]
    },
    {
      "display_name": "Monitor log size",
      "measure": "file_size",
      "path": "logs\\monitor.log",
      "size_unit": "MB",
      "target": 50,
      "check_interval_sec": 60,
      "thresholds": [
        {
          "level": "warning",
          "condition": "above",
          "percent_of_target": 80,
          "description": "Monitor log above 80% of its 50 MB rotation size",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING DOC: {document} is {current_value} {unit} ({current_percent}% of {target} {unit}; threshold {percent_of_target}%)"
            }
          ]
        },
        {
          "level": "critical",
          "condition": "above",
          "percent_of_target": 95,
          "description": "Monitor log about to rotate (95% of 50 MB)",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL DOC: {document} is {current_value} {unit} ({current_percent}% of {target} {unit}; threshold {percent_of_target}%)"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] {document} on {hostname} at {current_value} {unit} — {timestamp}",
              "body_template": "Document: {document}\nTimestamp: {timestamp}\nFile size: {current_value} {unit}\nLimit: {target} {unit}\nUsed: {current_percent}%\nThreshold: {percent_of_target}%\n\nThe log rotates at global.log_max_size_mb. Check what is logging so much."
            }
          ]
        }
      ]
    }
  ],
  "others": {
    "_comment": "Pending to define. Add new monitoring sections here following the same pattern: name, check_interval_sec, thresholds [ { level, condition/value, actions [] } ]",
    "items": []
  }
}
