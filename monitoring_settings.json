{
  "_meta": {
    "version": "1.6.0",
    "last_updated": "2026-11-13",
    "description": "Monitoring configuration: defines what to watch, thresholds, and automated actions.",
    "update_notes": "Bump version and update last_updated whenever you change this file."
  },
  "global": {
    "check_interval_sec": 6,
    "log_file": "logs\\monitor.log",
    "log_max_size_mb": 50,
    "email_recipient": "alerts@example.com",
    "email_sender": "monitor@example.com",
    "email_cooldown_min": 60,
    "scripts_dir": "scripts"
  },
  "processes": [
    {
      "name": "explorer.exe",
      "display_name": "Windows Explorer",
      "required": true,
      "check_interval_sec": 30,
      "actions": {
        "on_not_running": [
          {
            "type": "log_to_file",
            "level": "warning",
            "instructions": "Windows Explorer (the desktop shell) is not running.\n\n1. Press Ctrl+Shift+Esc to open Task Manager.\n2. File > Run new task > type explorer.exe > OK.\n3. If it keeps crashing, check Event Viewer > Windows Logs > Application."
          }
        ]
      }
    },
    {
      "name": "notepad.exe",
      "display_name": "Notepad",
      "required": true,
      "check_interval_sec": 30,
      "actions": {
        "on_not_running": [
          {
            "type": "log_to_file",
            "level": "warning",
            "instructions": "Notepad is not running (demo process: open and close it to see the alert and recovery).\n\nRunbook:\n1. Start Notepad from the Start menu.\n2. If it fails to start, check Event Viewer > Windows Logs > Application.\n3. Escalate to the on-call engineer if the issue persists."
          }
        ]
      }
    }
  ],
  "performance": {
    "cpu": {
      "check_interval_sec": 5,
      "thresholds": [
        {
          "level": "warning",
          "percent": 80,
          "sustain_sec": 30,
          "description": "CPU above 80% sustained for 30s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING CPU: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            }
          ]
        },
        {
          "level": "critical",
          "percent": 95,
          "sustain_sec": 60,
          "description": "CPU above 95% sustained for 60s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL CPU: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] CPU Alert on {hostname} — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nMetric: CPU Usage\nCurrent Value: {current_value}%\nThreshold: {percent}%\nSustained for: {sustain_sec}s\n\nPlease investigate immediately."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_cpu_critical.ps1",
              "args": [
                "--level",
                "critical",
                "--value",
                "{current_value}"
              ]
            }
          ]
        }
      ]
    },
    "memory": {
      "check_interval_sec": 5,
      "thresholds": [
        {
          "level": "warning",
          "percent": 85,
          "sustain_sec": 30,
          "description": "RAM above 85% sustained for 30s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING MEM: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            }
          ]
        },
        {
          "level": "critical",
          "percent": 95,
          "sustain_sec": 30,
          "description": "RAM above 95% sustained for 30s",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL MEM: {current_value}% sustained {sustain_sec}s (threshold: {percent}%)"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] Memory Alert on {hostname} — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nMetric: Memory Usage\nCurrent Value: {current_value}%\nThreshold: {percent}%\nSustained for: {sustain_sec}s\n\nPlease investigate immediately."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_memory_critical.ps1",
              "args": [
                "--level",
                "critical",
                "--value",
                "{current_value}"
              ]
            }
          ]
        }
      ]
    }
  },
  "disk": [
    {
      "drive": "C:\\",
      "display_name": "System Drive (C:)",
      "check_interval_sec": 60,
      "thresholds": [
        {
          "level": "warning",
          "percent_used": 75,
          "description": "Disk C: at 75% capacity",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING DISK C: {current_value}% used, {free_gb} GB free (threshold: {percent_used}%)"
            }
          ]
        },
        {
          "level": "critical",
          "percent_used": 90,
          "description": "Disk C: at 90% capacity",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL DISK C: {current_value}% used, {free_gb} GB free (threshold: {percent_used}%)"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] Disk Space Alert on {hostname} (C:) — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nDrive: C:\\\nUsed: {current_value}%\nFree Space: {free_gb} GB\nThreshold: {percent_used}%\n\nImmediate cleanup or expansion required."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_disk_critical.ps1",
              "args": [
                "--drive",
                "C:",
                "--value",
                "{current_value}"
              ]
            }
          ]
        }
      ]
    }
  ],
  "network": [
    {
      "name": "Internet Gateway",
      "host": "8.8.8.8",
      "port": 53,
      "protocol": "icmp",
      "timeout_sec": 5,
      "check_interval_sec": 30,
      "thresholds": [
        {
          "level": "warning",
          "latency_ms": 150,
          "description": "Round-trip latency above 150 ms",
          "actions": [
            {
              "type": "log_to_file",
              "level": "warning",
              "message_template": "[{timestamp}] WARNING NET: {host} latency {current_value}ms (threshold: {latency_ms}ms)"
            }
          ]
        },
        {
          "level": "critical",
          "condition": "unreachable",
          "description": "Host is unreachable / no response",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL NET: {host} unreachable"
            },
            {
              "type": "email_draft",
              "to": "{global.email_recipient}",
              "subject_template": "[CRITICAL] Network Outage on {hostname} — {timestamp}",
              "body_template": "Server: {hostname}\nTimestamp: {timestamp}\nTarget: {host}:{port}\nStatus: UNREACHABLE\n\nPossible internet outage or gateway failure. Please investigate immediately."
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_network_down.ps1",
              "args": [
                "--host",
                "{host}"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Monitoring Console",
      "host": "localhost",
      "port": 5758,
      "protocol": "tcp",
      "timeout_sec": 3,
      "check_interval_sec": 15,
      "thresholds": [
        {
          "level": "critical",
          "condition": "unreachable",
          "description": "Monitoring console on port 5758 not responding",
          "actions": [
            {
              "type": "log_to_file",
              "level": "critical",
              "message_template": "[{timestamp}] CRITICAL SVC: localhost:5758 unreachable"
            },
            {
              "type": "run_script",
              "path": "{global.scripts_dir}\\actions\\on_service_down.ps1",
              "args": [
                "--port",
                "5758"
              ]
            }
          ]
        }
      ]
    }
  ],
  "document": {
    "display_name": "Groceries spend (monthly budget)",
    "path": "sample_data\\monthly_budget_sample.csv",
    "filter_column": "Category",
    "filter_value": "Groceries",
    "value_column": "Amount",
    "target": 400,
    "unit": "$",
    "check_interval_sec": 30,
    "thresholds": [
      {
        "level": "warning",
        "condition": "above",
        "percent_of_target": 80,
        "description": "Groceries spend above 80% of the monthly budget",
        "actions": [
          {
            "type": "log_to_file",
            "level": "warning",
            "message_template": "[{timestamp}] WARNING DOC: {document} at {unit}{current_value} ({current_percent}% of {unit}{target}; threshold {percent_of_target}%)"
          }
        ]
      },
      {
        "level": "critical",
        "condition": "above",
        "percent_of_target": 100,
        "description": "Groceries budget used up",
        "actions": [
          {
            "type": "log_to_file",
            "level": "critical",
            "message_template": "[{timestamp}] CRITICAL DOC: {document} at {unit}{current_value} ({current_percent}% of {unit}{target}; threshold {percent_of_target}%)"
          },
          {
            "type": "popup",
            "title": "Budget alert: {document}",
            "message_template": "{document} is at {unit}{current_value}, {current_percent}% of the {unit}{target} budget."
          },
          {
            "type": "email_draft",
            "to": "{global.email_recipient}",
            "subject_template": "[CRITICAL] {document} over budget on {hostname} — {timestamp}",
            "body_template": "Document: {document}\nTimestamp: {timestamp}\nCurrent total: {unit}{current_value}\nTarget: {unit}{target}\nUsed: {current_percent}%\nThreshold: {percent_of_target}%\n\nReview the spending in the source file."
          }
        ]
      }
    ]
  },
  "others": {
    "_comment": "Pending to define. Add new monitoring sections here following the same pattern: name, check_interval_sec, thresholds [ { level, condition/value, actions [] } ]",
    "items": []
  }
}
